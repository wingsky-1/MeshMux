package view

import (
	"time"

	nodedomain "github.com/wingsky-1/MeshMux/internal/core/node"
	"github.com/wingsky-1/MeshMux/internal/control/store"
)

templ Document(title string) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · MeshMux</title>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"selfRequestsOnly":true,"historyCacheSize":0,"timeout":10000}'/>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Brand() {
	<a class="brand" href="/" aria-label="MeshMux 概览"><span class="mark" aria-hidden="true">M</span><span>MeshMux<small>网络，由你掌控</small></span></a>
}

templ AuthPage(setup bool, csrf string, dev bool, message string, op string) {
	@Document("管理员认证") {
		<div class="auth-wrap">
			<section class="auth-story">
				@Brand()
				<div><p class="eyebrow">YOUR NETWORK. YOUR CONTROL.</p><h1>连接每一处。<br/><span>从这里开始。</span></h1><p class="lead">代理、私有组网与路由策略，<br/>一个清晰的管理入口。</p></div>
				<p class="muted">开发预览 · Web 安全基座<br/>代理与 Mesh 状态：pending-verification</p>
			</section>
			<main class="auth-card">
				<div class="pill">本地管理员</div>
				if setup {
					<h2>初始化你的控制台</h2>
					<p class="muted">需要本机引导凭据；初始化完成后此入口关闭。</p>
				} else {
					<h2>欢迎回来</h2>
					<p class="muted">登录 MeshMux，查看你的管理控制台。</p>
				}
				if dev {
					<div class="notice">本地开发模式 · HTTP 仅用于隔离环境</div>
				}
				if message != "" {
					<div class="error" role="alert">{ message }<small>AUTH_FAILED · { op }</small></div>
				}
				<form method="post" action={ templ.SafeURL(authAction(setup)) }>
					<input type="hidden" name="csrf" value={ csrf }/>
					<label for="account">管理员账号</label><input id="account" value="admin" autocomplete="username" readonly/>
					if setup {
						<label for="bootstrap">一次性引导凭据</label><input id="bootstrap" name="bootstrap" type="password" autocomplete="off" required maxlength="128" title="来自服务私有目录的 bootstrap.token，有效期 30 分钟"/>
						<p class="hint">从服务私有目录的 bootstrap.token 读取，有效期 30 分钟，勿外传。</p>
						<label for="password">设置管理员密码</label><input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256"/>
						<p class="hint">至少 12 个字符；建议使用密码管理器。</p>
						<button type="submit">初始化管理员</button>
					} else {
						<label for="password">密码</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256" autofocus/>
						<button type="submit">登录控制台</button>
					}
				</form>
				<p class="auth-foot">单管理员 · 安全会话 · 无第三方账户</p>
			</main>
		</div>
	}
}

templ Dashboard(p PageData) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range Navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> Web 基座 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">Web 安全基座</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					if p.Path=="/" {
						<p class="subtitle">欢迎回来。控制台已就绪，从这里查看后续纳管状态。</p>
						<section class="stats" aria-label="资源概览">
							<article><div class="stat-label">代理节点 <span>◇</span></div><strong>0</strong><p>尚未纳管 Line / Out</p></article>
							<article><div class="stat-label">订阅用户 <span>◎</span></div><strong>0</strong><p>尚未创建订阅</p></article>
							<article><div class="stat-label">Mesh 设备 <span>⌘</span></div><strong>0</strong><p>尚未连接私有网络</p></article>
							<article><div class="stat-label">待处理任务 <span>▤</span></div><strong>—</strong><p>任务执行器尚未接入</p></article>
						</section>
						<div class="overview-grid">
							<section class="panel network-panel"><div class="panel-heading"><h2>网络状态</h2><span class="badge">未部署</span></div><div class="empty-network"><span class="network-symbol" aria-hidden="true">◇</span><h3>你的网络，从第一个节点开始</h3><p>当前没有连接任何代理或 Mesh 服务。<br/>节点纳管将在后续阶段开放。</p><a href="/nodes">查看代理节点</a></div></section>
							<section class="panel">
								<div class="panel-heading"><h2>控制台状态</h2><span class="badge accent">本机</span></div>
								@Status("当前请求")
								<p class="hint">只表示 Web 请求已处理，不代表代理握手、Mesh 或公网可用。</p><a class="refresh" href="/" hx-get="/status" hx-target="#web-status" hx-swap="outerHTML">刷新状态 ↻</a>
								<p id="status-feedback" class="hint" role="status"></p>
							</section>
						</div>
						<section class="panel next-panel"><div><span class="eyebrow">接下来</span><h2>建立连接之前，先把基础做好。</h2><p>本阶段开放管理员认证与安全设置；安装、代理、组网和订阅等待后续验收。</p></div><a class="secondary-link" href="/settings">安全设置 →</a></section>
					} else if p.Path=="/settings" {
						<p class="subtitle">管理本地管理员凭据与会话。</p>
						<div class="settings-grid">
							<section class="panel"><h2>修改管理员密码</h2><p class="muted">修改成功后撤销所有会话，请使用新密码重新登录。</p><form method="post" action="/password"><input type="hidden" name="csrf" value={ p.CSRF }/><label for="current">当前密码</label><input id="current" name="current_password" type="password" autocomplete="current-password" required maxlength="256"/><label for="new">新密码</label><input id="new" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256"/><p class="hint">至少 12 个字符。</p><button type="submit">修改密码并退出登录</button></form></section>
							<section class="panel">
								<h2>认证边界</h2>
								<dl class="details">
									<dt>账号</dt>
									<dd>admin · 单管理员</dd>
									<dt>会话</dt>
									<dd>最长 8 小时 / 空闲 30 分钟</dd>
									<dt>并行登录</dt>
									<dd>新登录替换旧会话</dd>
									<dt>登录保护</dt>
									<dd>10 次失败 / 10 分钟锁定，成功认证即清零</dd>
									<dt>代理 IP 信任</dt>
									<dd>
										if p.DirectProxy {
											<span>仅本机直连 Caddy</span>
										} else {
											<span>关闭</span>
										}
									</dd>
								</dl>
								<p class="hint">Fail2ban 候选配置与软件升级将在后续版本接入。</p>
							</section>
						</div>
					} else if p.Path=="/tasks" || p.Path=="/logs" {
						<p class="subtitle">操作结果需要可追踪，也需要真实的验证证据。</p>
						<div class="notice">以下是静态失败示例，不是真实任务或主机探测结果。</div>
						<section class="panel"><div class="panel-heading"><h2>SSH 监听端口预检 · 示例</h2><span class="badge failure">模拟失败</span></div><dl class="details"><dt>operation_id</dt><dd><code>demo-ssh-preflight</code></dd><dt>阶段</dt><dd>validate · 只读预检</dd><dt>error_code</dt><dd><code>SSH_LISTENER_MISMATCH</code></dd><dt>原因</dt><dd>示例中 SSH 实际监听端口与 jail 覆盖不一致。</dd><dt>建议动作</dt><dd>在安装阶段核对 sshd 实际监听端口与 Fail2ban action 的端口（IPv4 / IPv6 分开核对）。</dd></dl><p class="hint">本阶段不读取系统配置、不执行命令；真实任务与日志查询尚未实现。</p></section>
					} else {
						<p class="subtitle">{ p.Title }将在后续开发阶段开放。</p>
						<section class="panel empty-page"><span class="network-symbol" aria-hidden="true">◇</span><h2>此入口尚无可用页面</h2><p>状态以各功能页和任务记录为准。</p><a href="/">返回概览 →</a></section>
					}
					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>开发预览，不用于生产环境</span></footer>
				</main>
			</div>
		</div>
	}
}

templ NodesPage(p PageData, nodes []store.Node, data NodesData, created *store.Node, pairAction string, pairingCode string, hubOrigin string, artifact *InstallArtifact) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range Navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> 节点配对 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">待纳管 · 一次性配对</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					<p class="subtitle">创建节点后，在目标 Debian 主机核验本地 CLI 的 SHA-256，再在安装器提示处输入一次性配对码完成配对。</p>
					if data.Notice != "" {
						<div class="notice">{ data.Notice }</div>
					}
					<section class="panel out-pool"><div class="panel-heading"><h2>出口池（Out / HTTP 代理）</h2><span class="badge">{ len(data.Pool) } 个已纳管 · 不限个数</span></div>
						{{ bound, missing := 0, 0 }}
						for _, entry := range data.Pool {
							if entry.Enabled {
								{{ bound++ }}
							}
							if !entry.TransportConfigured {
								{{ missing++ }}
							}
						}
						<p class="muted">{ bound } 个被订阅选中 · { missing } 个未配置出口地址。Out 与 Line 纳管即互通；HTTP 代理是外部端点（无 Agent、不参与 ACL），订阅只决定客户端走哪个出口。</p>
						<a class="button" href="#enroll">纳管节点</a>
					</section>
					if created != nil {
							<section class="panel">
								if pairAction == "reissued" {
									<div class="panel-heading"><h2>节点身份已重签 · 仅显示一次</h2><span class="badge accent">15 分钟有效</span></div>
								} else {
									<div class="panel-heading"><h2>配对码已签发 · 仅显示一次</h2><span class="badge accent">15 分钟有效</span></div>
								}
							<dl class="details"><dt>Node ID（不可变）</dt><dd><code data-copy>{ created.ID }</code></dd><dt>角色</dt><dd>{ created.Role }</dd><dt>一次性配对码</dt><dd><code data-copy>{ pairingCode }</code></dd></dl>
							@InstallCommand(created, pairingCode, hubOrigin, artifact)
						</section>
					}
					<div class="settings-grid">
						<section class="panel"><h2>创建待纳管节点</h2><p class="muted">节点纳管不限个数，Out 池可按需扩展；Out 出口地址在下方节点卡片中配置。</p><a class="button" href="#enroll">纳管节点</a></section>
						<section class="panel"><h2>安装制品</h2><dl class="details"><dt>Agent 版本</dt><dd><code>{ nodedomain.CurrentAgentVersion() }</code></dd><dt>内核</dt><dd><code>{ nodedomain.KernelVersion }</code></dd>
							if artifact != nil {
								<dt>当前架构</dt><dd>{ artifact.Architecture }</dd><dt title="下载后请先核对再执行">CLI SHA-256</dt><dd><code data-copy>{ artifact.SHA256 }</code></dd>
								<p class="hint">只提供当前 Hub 架构的 CLI；其他架构请使用同源、已核验的构建，不使用 latest 或 curl | sh。</p>
								<a href="/api/nodes/cli">下载当前同源 CLI</a>
							} else {
								<dt>下载制品</dt><dd class="muted">开发预览无 CLI 制品，节点管理仍可使用</dd>
								<p class="hint">请从已安装的 meshmux __internal-web 获取固定制品。</p>
							}
						</dl></section>
					</div>
					<div id="enroll" class="modal" role="dialog" aria-label="纳管节点"><div class="modal-card"><section class="panel"><div class="panel-heading"><h2>纳管节点</h2><a class="text-button" href="#">关闭 ✕</a></div><form method="post" action="/nodes"><input type="hidden" name="csrf" value={ p.CSRF }/><span class="field-label">角色</span><div class="radio-row"><label><input type="radio" name="role" value="edge" checked required/>Line（edge）· 客户端入口</label><label><input type="radio" name="role" value="out" required/>Out · 可选私有出口</label><label><input type="radio" name="role" value="http" required/>HTTP 代理 · 外部出口</label></div><label for="display_name">展示名</label><input id="display_name" name="display_name" type="text" required maxlength="64" placeholder="例如 line-hk-01"/><div id="node-port-fields"><label for="vless_port">VLESS 端口</label><input id="vless_port" name="vless_port" type="number" min="1" max="65535" placeholder="例如 8443"/><label for="ssh_port">期望 SSH 端口</label><input id="ssh_port" name="ssh_port" type="number" min="1" max="65535" placeholder="例如 2222"/></div><div id="http-proxy-fields"><label for="proxy_url">HTTP 代理 URL</label><input id="proxy_url" name="proxy_url" type="text" maxlength="512" placeholder="http://user:pass@proxy.example.invalid:8080"/><p class="hint">仅接受 http://主机:端口，可带用户名与密码，不带路径或查询参数；页面与日志只显示 host:port。HTTP 代理是外部节点：无 Agent、无配对、不参与 ACL。</p></div><p class="hint">Line / Out 需要 VLESS 与 SSH 端口（两者必须不同）；Out 创建后在节点卡片配置出口地址。配对码 15 分钟过期、一次性使用、不记日志（HTTP 代理不需要配对码）。</p><button type="submit">创建节点</button></form></section></div></div>
						<section class="panel"><div class="panel-heading"><h2>节点列表</h2><span class="badge">待纳管</span></div>
					if len(nodes) == 0 {
						<p class="muted">尚未创建待纳管节点。</p>
					}
					for _, n := range nodes {
							{{ heartbeatAt := "尚未收到" }}
							{{ if n.LastHeartbeat != 0 { heartbeatAt = time.Unix(n.LastHeartbeat, 0).Format("2006-01-02 15:04:05") } }}
							<article class="node-card">
								<div class="panel-heading">
									<h3>{ n.DisplayName }</h3>
									if n.Role == "http" {
										<span class="badge accent">外部声明</span>
									} else if n.Offline {
										<span class="badge failure">离线</span>
									} else {
										<span class="badge accent">最近联系</span>
									}
								</div>
									<dl class="details">
										<dt>Node ID</dt><dd><code data-copy>{ n.ID }</code></dd>
										if n.Role == "http" {
											<dt>角色</dt><dd>http · 外部 HTTP 代理（无 Agent、不参与 ACL）</dd>
										} else {
											<dt>角色 / 端口</dt><dd>{ n.Role } · VLESS { n.VlessPortString() } · SSH { n.SSHPortString() }</dd>
										}
										if n.Role != "http" {
										<dt title="节点心跳自报，未经回读验证">声明心跳版本</dt><dd>Agent { n.AgentVersion } · kernel { n.KernelVersion }</dd>
										<dt title="严格回读 = 本机实际运行版本，与心跳声明区分">回读版本</dt><dd>Agent { n.ObservedAgentVersion } · kernel { n.ObservedKernelVersion }</dd>
										<dt title="Agent 哈希为节点自报，未与 Hub 制品清单比对">Agent SHA-256</dt><dd><code data-copy>{ n.ObservedAgentSHA256 }</code></dd>
										<dt title="回读时已对照架构内核发行清单">内核 SHA-256</dt><dd><code data-copy>{ n.ObservedKernelSHA256 }</code></dd>
										<dt title="当前 Hub 同源 CLI；不是 Agent 回读 pin">CLI 制品 SHA-256</dt>
										<dd>
											if artifact != nil {
												<code data-copy>{ artifact.SHA256 }</code>
											} else {
												<span class="muted">无可用制品</span>
											}
										</dd>
										<dt>最近联系</dt><dd>{ heartbeatAt }</dd>
										<dt title="candidate 为最新期望，task 为最新任务修订">最新配置 / 任务</dt><dd>candidate rev { n.LatestConfigRevision } · task { n.LastTaskRevision }</dd>
										<dt>最近回读</dt><dd>observed rev { n.ObservedRevision } · task <code>{ n.ObservedTaskOperationID }</code> · { n.ObservedAtString() }</dd>
										<dt>最近任务</dt><dd>{ n.LastTaskKind } · { n.LastTaskStatus } · <code>{ n.LastTaskOperationID }</code></dd>
										if n.LastTaskErrorCode != "" {
											<dt>错误码</dt><dd><code>{ n.LastTaskErrorCode }</code></dd>
										}
										if n.LastFailureTaskErrorCode != "" {
											<dt>最近失败</dt><dd>{ n.LastFailureTaskKind } · task { n.LastFailureTaskRevision } · <code>{ n.LastFailureTaskOperationID }</code> · <code>{ n.LastFailureTaskErrorCode }</code></dd>
										}
										<dt title="只有最新 desired revision 与最新回读一致才标为已确认；旧回读不会覆盖 partial / failed / queued">服务状态</dt>
									<dd>
										if n.NativeReady {
												<span class="badge accent">本机服务已确认</span>
										} else {
												<span class="badge">未确认</span>
										}
									</dd>
										<dt>当前连接</dt>
										<dd>
											if n.Offline {
												<span>离线 · 暂不下发任务</span>
											} else {
												<span>最近联系</span>
											}
										</dd>
										}
								<dt>网络验证边界</dt><dd class="muted">公网、协议握手、客户端可用均未验证</dd>
								if n.Role == "out" {
									for _, entry := range data.Pool {
										if entry.OutID == n.ID {
											<dt>出口地址</dt><dd>
												if entry.TransportConfigured {
													<code>{ entry.Server }:{ entry.Port }</code>
												} else {
													<span class="badge failure">未配置出口地址</span>
												}
											</dd>
											<dt>配置出口地址</dt><dd><form method="post" action="/nodes/out-transport"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><label for={ "out-server-" + n.ID }>出口地址</label><input id={ "out-server-" + n.ID } name="server" type="text" required maxlength="253" placeholder="例如 out.example.invalid 或 203.0.113.10" value={ entry.Server }/><button type="submit">保存出口地址</button></form><p class="hint">端口须与 VLESS 端口（{ n.VlessPortString() }）一致；保存后选中该 Out 的订阅在下一次收敛中获得真实出站，凭据由 Hub 签发、不进日志。</p></dd>
											<dt>服务对象</dt><dd>
												if len(entry.LineIDs) == 0 {
													<span class="muted">没有订阅选择该 Out · 该 Out 不承载任何客户端出口</span>
												} else {
													for _, lineID := range entry.LineIDs {
														<div><span>承载 Line <code>{ lineID }</code></span><span class="badge accent">订阅已选择</span></div>
													}
												}
											</dd>
											<dt>出口操作</dt><dd><div class="action-row">
												<form method="post" action="/nodes/out-unbind"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><button class="secondary-button" type="submit">解除授权</button></form>
												if data.PendingDeleteOut == n.ID {
													<form method="post" action="/nodes/out-delete"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><input type="hidden" name="confirm" value="1"/><button class="secondary-button" type="submit">确认删除出口</button></form>
												} else {
													<form method="post" action="/nodes/out-delete"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><button class="secondary-button" type="submit">删除出口…</button></form>
												}
											</div>
												if data.PendingDeleteOut == n.ID {
													<p class="hint">删除会<strong>彻底清除</strong>该 Out（节点行、出口地址与 link key），引用它的 Line 路由按 fail-closed 重算，不会静默改走直连；<strong>仍被订阅选中、离线或有未完成链时删除会被拒绝</strong>并列出订阅名。</p>
												}
											</dd>
										}
									}
								} else if n.Role == "http" {
									for _, entry := range data.Pool {
										if entry.OutID == n.ID {
											<dt>出口地址</dt><dd>
												if entry.TransportConfigured {
													<code>{ entry.Server }:{ entry.Port }</code><span class="badge accent">外部声明</span>
												} else {
													<span class="badge failure">未配置代理 URL</span>
												}
											</dd>
											<dt>配置代理 URL</dt><dd><form method="post" action="/nodes/http-proxy"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><label for={ "http-proxy-url-" + n.ID }>HTTP 代理 URL</label><input id={ "http-proxy-url-" + n.ID } name="proxy_url" type="text" maxlength="512" placeholder="http://user:pass@proxy.example.invalid:8080"/><button type="submit">保存代理 URL</button></form><p class="hint">仅接受 http://主机:端口，不带路径或查询参数；页面与日志只显示 host:port。保存后引用该代理的 Line 在下一次收敛中获得新的 http 出站。</p></dd>
											<dt>服务对象</dt><dd>
												if len(entry.LineIDs) == 0 {
													<span class="muted">没有订阅选择该 HTTP 代理 · 它不承载任何客户端出口</span>
												} else {
													for _, lineID := range entry.LineIDs {
														<div><span>承载 Line <code>{ lineID }</code></span><span class="badge accent">订阅已选择</span></div>
													}
												}
											</dd>
											<dt>出口操作</dt><dd><div class="action-row">
												if data.PendingDeleteOut == n.ID {
													<form method="post" action="/nodes/out-delete"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><input type="hidden" name="confirm" value="1"/><button class="secondary-button" type="submit">确认删除出口</button></form>
												} else {
													<form method="post" action="/nodes/out-delete"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="out_id" value={ n.ID }/><button class="secondary-button" type="submit">删除出口…</button></form>
												}
											</div>
												if data.PendingDeleteOut == n.ID {
													<p class="hint">删除会<strong>彻底清除</strong>该 HTTP 代理（节点行与 URL/凭据），引用它的 Line 路由按 fail-closed 重算；<strong>仍被订阅选中时删除会被拒绝</strong>并列出订阅名。</p>
												}
											</dd>
										}
									}
								} else {
									<dt>Out 出口</dt><dd>
										if len(data.ByLine[n.ID]) == 0 {
											<span class="muted">没有订阅选择该 Line 的 Out · 客户端走直连出口</span>
										} else {
											for _, entry := range data.ByLine[n.ID] {
												<div><span>{ entry.DisplayName }</span><span class="badge accent">订阅已选择</span></div>
											}
										}
									</dd>
								}
									</dl>
									if n.Role == "http" {
										<p class="hint">外部 HTTP 代理没有 Agent、配对或 ACL：“外部声明”只是操作员声明的端点，页面与日志只显示 host:port。</p>
									} else {
									<div class="action-row">
										<form method="post" action="/nodes/reconcile"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="node_id" value={ n.ID }/><button type="submit">重新校验 / 应用</button></form>
										<form method="post" action="/nodes/reissue"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="node_id" value={ n.ID }/><button class="secondary-button" type="submit">重签身份</button></form>
										<form method="post" action="/nodes/revoke"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="node_id" value={ n.ID }/><button class="secondary-button" type="submit">吊销身份</button></form>
									</div>
									}
							</article>
					}
					<p class="hint">“本机服务已确认”= 最新期望配置与本机回读一致；check/stage/apply 成功本身不算确认。离线节点不会下发任务。</p>
					</section>
					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>节点配对 · 开发预览</span></footer>
				</main>
			</div>
		</div>
	}
}

templ InstallCommand(n *store.Node, pairingCode string, hubOrigin string, artifact *InstallArtifact) {
	<p class="hint">配对码请在安装器的 Pairing code 提示处输入；不要放入命令行、URL 或日志。</p>
	if artifact == nil {
		<p class="hint">当前开发预览不提供安装制品与可执行安装命令。</p>
	} else {
		<div class="copy-row"><p class="hint">先下载同源 CLI，核对固定 SHA-256 后再执行（命令不含配对码）：</p></div>
		<div class="copy-row"><div id="install-command"><pre><code>echo { ShellQuote(artifact.SHA256 + "  meshmux") } | sha256sum -c -
chmod +x meshmux
./meshmux install { ShellQuote(n.Role) } --hub { ShellQuote(hubOrigin) } --node { ShellQuote(n.ID) } --vless-port { ShellQuote(n.VlessPortString()) } --ssh-port { ShellQuote(n.SSHPortString()) }</code></pre></div><button type="button" class="copy-button text-button" data-copy-target="#install-command">复制安装命令</button></div>
	}
}

templ NodeActionPage(p PageData, nodeID string, configRevision int64, configSHA string, taskCount int) {
	@Document(p.Title) {
		<main class="error-page">
			@Brand()
			<section class="panel">
				<p class="eyebrow">FIXED CONFIG TRANSACTION</p>
				<h1>配置修订已发布</h1>
				<p>节点 <code>{ nodeID }</code> 的配置修订 <strong>{ configRevision }</strong> 已在四任务链中排队。</p>
				<dl class="details"><dt>编译配置 SHA-256</dt><dd><code data-copy>{ configSHA }</code></dd><dt>任务数</dt><dd>{ taskCount }</dd></dl>
				<p class="hint">本页只表示已排队；Agent 需完成 check、stage、apply 与回读后才算应用。</p>
				<a href="/nodes">返回节点列表 →</a>
			</section>
		</main>
	}
}

templ Status(checked string) {
	<div id="web-status" aria-live="polite"><dl class="status-list"><div><dt><span class="dot"></span> Web 服务</dt><dd>运行中</dd></div><div><dt>代理服务</dt><dd class="muted">未知</dd></div><div><dt>Mesh 网络</dt><dd class="muted">未知</dd></div><div><dt>公网与协议验证</dt><dd class="muted">待验证</dd></div></dl><p class="hint">更新于 { checked }</p></div>
}

templ ErrorPage(code string, message string, next string, op string) {
	@Document("请求未完成") {
		<main class="error-page">
			@Brand()
			<div class="panel"><span class="badge failure">请求未完成</span><h1>{ message }</h1><p>{ next }</p><dl class="details"><dt>错误码</dt><dd><code>{ code }</code></dd><dt>操作编号</dt><dd><code>{ op }</code></dd><dt>阶段</dt><dd>web</dd></dl><a href="/">返回控制台 →</a></div>
		</main>
	}
}
