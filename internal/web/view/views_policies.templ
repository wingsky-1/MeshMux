package view

// PoliciesPage renders the /policies route for issue #10. It shows the
// two-layer policy view (docs/UX.zh-CN.md 路由策略视图): the client layer on
// the device and the server layer on the Line.
//
// The server fills the snapshot from the active stored revisions, falling
// back to the read-only mesh model and built-in defaults. Saving is the write
// API and publication is POST /policies/publish. The page still renders no
// publish control: a button is added only after the visual draft is approved
// (docs/UX.zh-CN.md 交互安全性), so there is no clickable no-op here.
templ PoliciesPage(p PageData, v PolicyPageView) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range Navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> 路由策略 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">客户端层 · 服务端层</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					<link rel="stylesheet" href="/assets/policies.css"/>
					<p class="subtitle">路由策略分两层：客户端层决定设备上的流量走向，服务端层决定 Line 上的转发走向。每层从上到下匹配，先命中先生效。当前版本只有服务端层会下发到 Line；客户端层仅做预览与门禁校验。</p>
					if v.Draft {
						<div class="notice">当前没有可用的真实策略数据（需要已纳管 Line 与已收敛的 Mesh 订阅）；以下为设计示例，不写入配置，也不发布策略。</div>
					}

					<section class={ "panel", "out-state", templ.KV("out-degraded", v.Out == PolicyOutDegraded), templ.KV("out-active", v.Out == PolicyOutActive) }>
						<div class="panel-heading"><h2>Out 出口状态</h2>
							if v.Out == PolicyOutActive {
								<span class="badge accent">Out 已接入</span>
							} else if v.Out == PolicyOutDegraded {
								<span class="badge failure">Out 故障 · fail-closed</span>
							} else {
								<span class="badge">Out 未配置</span>
							}
						</div>
						if v.Out == PolicyOutActive {
							<p class="hint">AI 与指定分流优先经 Out 直出。Out 不可用时按 fail-closed 处理，不会自动改走 Line。</p>
						} else if v.Out == PolicyOutDegraded {
							<p class="hint">Out 健康检查未通过。指定到 Out 的分流进入 fail-closed：拒绝转发并提示目标不可达，不隐式回落到 Line 直出；恢复后自动退出该状态。</p>
						} else {
							<p class="hint">Out 是可选节点，未配置不是错误。AI 与指定分流按默认路径走 Line 直出，不生成任何指向 Out 的规则。</p>
						}
					</section>

					<div class="policy-split">
						<section class="panel">
							<div class="panel-heading"><h2>客户端层 · 设备侧分流</h2><span class="badge">{ PolicyPreviewLabel(len(v.Client), v.ClientDefault) }</span></div>
							<p class="muted">客户端层规则决定设备端是否分流，但当前版本<b>没有消费者</b>：标准订阅下载由固定导出器按 Line 与凭据生成，不读取客户端层，也不包含这些规则；发布客户端层只会渲染文档并交 sing-box / Mihomo 门禁，用于校验策略本身是否可渲染，不生成节点候选、不改变任何订阅字节。</p>
							<p class="muted">因此本页展示已激活的客户端策略时只作为预览；尚未激活时按默认意图预览。需要真正改变设备流量时，当前版本应使用服务端层。</p>
							<ul class="policy-rules">
								for _,rule:=range v.Client {
									<li>
										<div class="rule-line"><strong>{ rule.Match }</strong><span class="rule-action">{ rule.Action }</span><span class="badge">{ rule.State }</span></div>
										<p class="rule-note">{ rule.Note }</p>
									</li>
								}
							</ul>
						</section>
						<section class="panel">
							<div class="panel-heading"><h2>服务端层 · Line 出口分流</h2><span class="badge">{ PolicyCountLabel(len(v.Server), v.ServerDefault) }</span></div>
							<p class="muted">服务端层规则在 Line 上直接分流，设备不需要任何额外配置。本页展示已激活的服务端策略与 Out 三态；尚未激活时按默认意图预览。发布走 `POST /policies/publish`：装配出的路线先经 sing-box check，再与固定四任务链在同一事务写入候选；门禁或读取失败时不写入任何修订。</p>
							<ul class="policy-rules">
								for _,rule:=range v.Server {
									<li>
										<div class="rule-line"><strong>{ rule.Match }</strong><span class="rule-action">{ rule.Action }</span><span class="badge">{ rule.State }</span></div>
										<p class="rule-note">{ rule.Note }</p>
									</li>
								}
							</ul>
						</section>
					</div>

					<div class="policy-split">
						<section class="panel">
							<div class="panel-heading"><h2>优先级与冲突校验</h2><span class="badge">保存时校验</span></div>
							<p class="muted">每层规则按列表顺序从上到下匹配，先命中先生效。保存时校验优先级重叠，冲突会在这里列出，不会静默合并。</p>
							<ul class="policy-conflicts">
								for _,c:=range v.Conflicts {
									<li>
										if c.Blocked {
											<span class="badge failure">会拦截</span>
										} else {
											<span class="badge accent">通过</span>
										}
										<span class="conflict-text">{ c.Detail }</span>
									</li>
								}
							</ul>
							<p class="hint">调整顺序或合并条件后重新校验；已启用的规则停用后，命中它的流量回到该层兜底。</p>
						</section>
						<section class="panel">
							<div class="panel-heading"><h2>命中说明</h2><span class="badge">只读查询</span></div>
							<p class="muted">输入域名或 IP，按“规则 → 动作 → 实际出口 → DNS”四段链展示第一条命中的客户端规则；未命中任何规则时展示兜底。这是客户端层预览的命中说明，不改变订阅内容。geo 与远端 ruleset 需要已锁定的数据，本页不猜测结果。</p>
							<form class="policy-explain" method="get" action="/policies/explain">
								<label for="policy_target">目标域名或 IP</label>
								<input id="policy_target" name="target" type="text" maxlength="253" value={ v.Target } placeholder="news.example.invalid"/>
								<button type="submit">查询命中链</button>
							</form>
							if len(v.Hits) == 0 {
								<p class="muted">尚未查询；这里不会展示编造的命中结果。</p>
							} else {
								<div class="policy-hits">
									for _,h:=range v.Hits {
										<div class="hit-card">
											<h3>{ h.Title }</h3>
											<ol class="hit-chain">
												for _,s:=range h.Steps {
													<li><span class="hit-stage">{ s.Stage }</span>{ s.Value }</li>
												}
											</ol>
											if h.Note != "" {
												<p class="hint">{ h.Note }</p>
											}
										</div>
									}
								</div>
							}
						</section>
					</div>

					<section class="panel mobile-loop">
						<div class="panel-heading"><h2>移动端提示</h2><span class="badge">防回环</span></div>
						<p class="hint">标准订阅只包含 Line 与凭据，不含客户端层规则，因此导入后不会出现代理回环；客户端层分流需等消费该层的下发路径落地后才生效。Out 未配置或故障时，下发配置不会生成引用 Out 的规则，避免产生无法启动的无效配置。</p>
					</section>

					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>开发预览，不用于生产环境</span></footer>
				</main>
			</div>
		</div>
	}
}
