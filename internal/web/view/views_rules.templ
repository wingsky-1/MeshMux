package view

import (
	"strconv"
	"strings"
)

// RulesLibraryPage renders the /rules route for Task 3 (ADR-0008 §5): the
// preset seed bundle (read-only), the custom rows (latest revision with
// used-by names), the create modal, per-row view modals with the revise form,
// and the two-step delete protection. The page never edits a row in place and
// never deletes a referenced revision: both are refused server-side with the
// stable RULE_* codes.
templ RulesLibraryPage(p PageData, v RulesLibraryView) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range Navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> 规则库<small>预置随版本迁移替换</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">预置 · 自定义</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					<link rel="stylesheet" href="/assets/policies.css"/>
					<p class="subtitle">规则库是全部订阅分流的唯一真相源：预置规则随版本迁移替换、不可写；自定义规则按稳定键 + 版本不可变保存，修改只产生新版本。订阅按（稳定键，版本）引用规则，被引用的版本删除时会被拒绝并列出订阅名。</p>
					if v.Notice != "" {
						<div class="notice">{ v.Notice }</div>
					}
					if v.HasPending {
						<section class="panel">
							<div class="panel-heading"><h2>删除确认 · { v.Pending.Name }</h2><span class="badge failure">待确认</span></div>
							<p class="hint">待删除：{ v.Pending.StableKey } v{ strconv.Itoa(v.Pending.Version) }。确认删除前请核对版本：同一稳定键的其他版本不受影响。</p>
							if len(v.Pending.UsedBy) == 0 {
								<p class="hint">该版本没有订阅引用，确认后删除，不影响任何订阅。</p>
								<form method="post" action="/rules/delete"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="stable_key" value={ v.Pending.StableKey }/><input type="hidden" name="version" value={ strconv.Itoa(v.Pending.Version) }/><input type="hidden" name="confirm" value="1"/><button class="secondary-button" type="submit">确认删除</button> <a class="text-button" href="/rules">取消</a></form>
							} else {
								<p class="hint">正被 { strconv.Itoa(len(v.Pending.UsedBy)) } 个订阅引用：{ ruleUsedByNames(v.Pending.UsedBy) }。删除被拒绝——请先在订阅向导中把这些订阅迁移到其他版本后再删除。</p>
								<p><a class="text-button" href="/rules">返回规则库</a></p>
							}
						</section>
					}

					<section class="panel">
						<div class="panel-heading"><h2>预置规则</h2><span class="badge">{ strconv.Itoa(len(v.Presets)) } 条</span></div>
						<p class="muted">预置规则由版本种子下发，随版本迁移替换、不原地修改；存量订阅停留在旧版本语义并标注可升级，不自动变。</p>
						<p class="hint">！ 预置规则不可写：任何创建、修改、删除预置规则的请求都会被 RULE_PRESET_IMMUTABLE 拒绝。</p>
						if len(v.Presets) == 0 {
							<p class="muted">预置规则尚未载入：通常意味着数据库迁移未完成，请检查服务日志后再刷新本页。</p>
						}
						<ul class="policy-rules">
							for _,row:=range v.Presets {
								<li>
									<div class="rule-line"><strong>{ row.Name }</strong><span class="rule-action">{ row.Action }</span><span class="badge">预置</span><a class="text-button" href={ templ.SafeURL("#rule-view-" + row.StableKey + "-v" + strconv.Itoa(row.Version)) }>查看</a></div>
									<p class="rule-note">{ row.Matcher } · { row.StableKey } v{ strconv.Itoa(row.Version) } · { ruleUsedByLabel(row.UsedBy) }</p>
								</li>
							}
						</ul>
					</section>

					<section class="panel">
						<div class="panel-heading"><h2>自定义规则</h2><span class="badge">{ strconv.Itoa(len(v.Customs)) } 条</span><a class="text-button" href="#rule-new">新建规则</a></div>
						<p class="muted">自定义规则按“稳定键 + 版本”不可变保存：修改匹配或动作只产生新版本，旧版本订阅的下载字节不变。</p>
						<p class="hint">！ 一条规则只能有一种匹配器（域名 / 域名后缀 / IP 网段 / GeoSite / GeoIP / 规则集），非法值在保存时被拒绝，不静默修正。</p>
						if len(v.Customs) == 0 {
							<p class="muted">暂无自定义规则；点右上“新建规则”创建第一条。</p>
						}
						<ul class="policy-rules">
							for _,row:=range v.Customs {
								<li>
									<div class="rule-line"><strong>{ row.Name }</strong><span class="rule-action">{ row.Action }</span><span class="badge">自定义</span><a class="text-button" href={ templ.SafeURL("#rule-view-" + row.StableKey + "-v" + strconv.Itoa(row.Version)) }>查看</a></div>
									<p class="rule-note">{ row.Matcher } · { row.StableKey } v{ strconv.Itoa(row.Version) } · { ruleUsedByLabel(row.UsedBy) }</p>
								</li>
							}
						</ul>
					</section>

					for _,row:=range v.Presets {
						@ruleViewModal(p, row)
					}
					for _,row:=range v.Customs {
						@ruleViewModal(p, row)
					}

					<div id="rule-new" class="modal" role="dialog" aria-label="新建规则"><div class="modal-card"><section class="panel"><div class="panel-heading"><h2>新建规则</h2><a class="text-button" href="#">关闭 ✕</a></div>
						<form method="post" action="/rules"><input type="hidden" name="csrf" value={ p.CSRF }/>
							<label for="rule-new-key">稳定键</label>
							<input id="rule-new-key" name="stable_key" type="text" required maxlength="64" placeholder="例如 proxy-ai" pattern="[a-z0-9][a-z0-9-]*"/>
							<p class="hint">小写字母、数字、连字符；以 preset- 开头为预置保留，会被拒绝。</p>
							<label for="rule-new-name">展示名</label>
							<input id="rule-new-name" name="name" type="text" required maxlength="80" placeholder="例如 AI 走代理"/>
							<label for="rule-new-action">动作</label>
							<select id="rule-new-action" name="action"><option value="direct">直连</option><option value="proxy">代理</option><option value="reject">拒绝</option></select>
							<label for="rule-new-kind">匹配器（六选一）</label>
							<select id="rule-new-kind" name="matcher_kind"><option value="domain">域名（完全匹配）</option><option value="domain_suffix">域名后缀</option><option value="ipcidr">IP 网段（CIDR）</option><option value="geosite">GeoSite 标签</option><option value="geoip">GeoIP 标签</option><option value="ruleset">规则集标签</option></select>
							<label for="rule-new-values">匹配值（每行一个）</label>
							<textarea id="rule-new-values" name="values" rows="4" required placeholder="域名 dl.example.invalid / 后缀 ads.example.invalid / 网段 198.51.100.0/24 / 标签小写如 cn、ai"></textarea>
							<p class="hint">！ 保存时校验：非法域名、非规范 CIDR、大写标签都会被拒绝；重复值也会被拒绝。</p>
							<button type="submit">创建 v1 →</button>
						</form>
					</section></div></div>

					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>规则库：预置随版本迁移替换</span></footer>
				</main>
			</div>
		</div>
	}
}

// ruleViewModal is the per-row view dialog: details, version trail, used-by
// names, the revise form for customs, and the two-step delete entry.
templ ruleViewModal(p PageData, row RuleLibraryRow) {
	<div id={ "rule-view-" + row.StableKey + "-v" + strconv.Itoa(row.Version) } class="modal" role="dialog" aria-label={ "查看规则 " + row.Name }><div class="modal-card"><section class="panel"><div class="panel-heading"><h2>{ row.Name }</h2><a class="text-button" href="#">关闭 ✕</a></div>
		<p class="muted">{ row.Matcher }</p>
		<p class="hint">动作：{ row.Action } · 来源：{ row.Origin } · 版本链：{ RuleVersionsLabel(row.History, row.Version) }</p>
		<p class="hint">引用订阅：{ ruleUsedByNames(row.UsedBy) }</p>
		if !row.Preset {
			<form method="post" action="/rules/revise"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="stable_key" value={ row.StableKey }/>
				<span class="field-label">修改（只产生新版本，旧版本订阅不受影响）</span>
				<label for={ "rev-name-" + row.StableKey }>展示名</label>
				<input id={ "rev-name-" + row.StableKey } name="name" type="text" required maxlength="80" value={ row.Name }/>
				<label for={ "rev-action-" + row.StableKey }>动作</label>
				<select id={ "rev-action-" + row.StableKey } name="action">
					<option value="direct" selected?={ row.ActionValue == "direct" }>直连</option>
					<option value="proxy" selected?={ row.ActionValue == "proxy" }>代理</option>
					<option value="reject" selected?={ row.ActionValue == "reject" }>拒绝</option>
				</select>
				<label for={ "rev-kind-" + row.StableKey }>匹配器</label>
				<select id={ "rev-kind-" + row.StableKey } name="matcher_kind">
					<option value="domain" selected?={ row.KindValue == "domain" }>域名（完全匹配）</option>
					<option value="domain_suffix" selected?={ row.KindValue == "domain_suffix" }>域名后缀</option>
					<option value="ipcidr" selected?={ row.KindValue == "ipcidr" }>IP 网段（CIDR）</option>
					<option value="geosite" selected?={ row.KindValue == "geosite" }>GeoSite 标签</option>
					<option value="geoip" selected?={ row.KindValue == "geoip" }>GeoIP 标签</option>
					<option value="ruleset" selected?={ row.KindValue == "ruleset" }>规则集标签</option>
				</select>
				<label for={ "rev-values-" + row.StableKey }>匹配值（每行一个）</label>
				<textarea id={ "rev-values-" + row.StableKey } name="values" rows="4" required>{ row.ValuesText }</textarea>
				<button type="submit">生成新版本 →</button>
			</form>
		}
		if !row.Preset {
			<form method="post" action="/rules/delete"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="stable_key" value={ row.StableKey }/><input type="hidden" name="version" value={ strconv.Itoa(row.Version) }/><button class="secondary-button" type="submit">删除该版本…</button></form>
		} else {
			<p class="hint">预置规则不可删除，随版本迁移替换。</p>
		}
	</section></div></div>
}

func ruleUsedByLabel(names []string) string {
	if len(names) == 0 {
		return "暂无订阅引用"
	}
	return "引用订阅：" + strings.Join(names, "、")
}

func ruleUsedByNames(names []string) string {
	if len(names) == 0 {
		return "无"
	}
	return strings.Join(names, "、")
}
