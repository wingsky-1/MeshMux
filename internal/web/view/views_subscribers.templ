package view

// SubscribersPage renders the subscriber management workspace.
//
// The page separates two kinds of truth on every Line row:
//
//   - 期望 (intent): what the operator asked for on the Hub;
//   - 已确认 (confirmed): what the Line itself proved by its own readback.
//
// A queued publication, a delivered task or a successful Hub write is never
// rendered as a confirmed remote state. The "已确认" boundary is stated once,
// next to the wizard link where the operator acts on it.
import "github.com/wingsky-1/MeshMux/internal/control/store"

templ SubscribersPage(p PageData, v SubscriberPageView) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range Navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> 订阅用户 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">订阅 · 线路 · Token</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					<link rel="stylesheet" href="/assets/subscribers.css"/>
					<p class="subtitle">快速创建只选线路；需要同时选择 Out、规则与组网设备时，用右侧提示的<a href="/subscribers/wizard">订阅向导</a>（四组选择一次保存）。</p>
					if v.Token != "" {
						<section class="panel">
							<div class="panel-heading"><h2>订阅 Token 已签发 · 仅显示一次</h2><span class="badge accent">{ v.TokenOwner }</span></div>
							<p class="hint">Token 只显示这一次；离开此页无法再查看，遗失请轮换。<span class="info" title="订阅地址同样包含 Token，勿写入日志或公开页面；控制台只保存校验值。">!</span></p>
							<div class="copy-row"><div id="sub-token-value"><pre class="sub-secret">{ v.Token }</pre></div><button type="button" class="copy-button text-button" data-copy-target="#sub-token-value">复制</button></div>
							<div class="sub-links">
								<a href={ templ.SafeURL(subscriptionDownloadURL(v.Origin, v.Token, "sing-box.json")) } rel="noreferrer noopener">sing-box.json 订阅地址</a>
								<a href={ templ.SafeURL(subscriptionDownloadURL(v.Origin, v.Token, "mihomo.yaml")) } rel="noreferrer noopener">mihomo.yaml 订阅地址</a>
							</div>
						</section>
					}
					<div class="sub-split">
						<section class="panel">
							<h2>创建订阅用户</h2>
							<p class="muted">创建时为每个所选 Line 生成独立 VLESS UUID，并签发第一个订阅 Token。</p>
							<form method="post" action="/subscribers">
								<input type="hidden" name="csrf" value={ p.CSRF }/>
								<label for="subscriber_name">展示名</label>
								<input id="subscriber_name" name="display_name" type="text" required maxlength="80" placeholder="例如 alice-iphone"/>
								<label>纳入线路</label>
								if len(v.Lines) == 0 {
									<p class="hint">还没有已配置的线路。请先在右侧保存至少一条 Line。</p>
								} else {
									<div class="sub-check-list">
										for _,line:=range v.Lines {
											<label class="sub-check">
												<input type="checkbox" name={ "line_" + line.NodeID } value="1"/>
												<span class="sub-check-text">{ line.DisplayName }<small>{ line.Server }:{ line.Port } · 排序 { line.SortOrder }</small></span>
											</label>
										}
									</div>
								}
								<p class="hint">展示名只是标签，随时可改。</p>
								<button type="submit">创建订阅用户 →</button>
							</form>
							<p class="hint">要同时选择 Out、规则与组网设备，请使用 <a href="/subscribers/wizard">订阅向导</a>（四组选择一次保存）。</p>
						</section>
							<section class="panel">
								<h2>线路参数</h2>
								<p class="muted">一条 Line 对应一个已纳管的 Line 节点（edge）；REALITY 私钥不出页面。</p>
								<form method="post" action="/lines">
									<input type="hidden" name="csrf" value={ p.CSRF }/>
									<label for="line_node">Line 节点</label>
									<select id="line_node" name="node_id" required>
										if len(v.EdgeNodes) == 0 {
											<option value="">尚无已纳管的 Line 节点</option>
										}
										for _,node:=range v.EdgeNodes {
											<option value={ node.ID }>{ node.DisplayName } · { node.ID }</option>
										}
									</select>
									<div class="sub-inline">
										<div>
											<label for="line_display">展示名</label>
											<input id="line_display" name="display_name" type="text" required maxlength="80" placeholder="例如 香港 01"/>
										</div>
										<div>
											<label for="line_order">排序</label>
											<input id="line_order" name="sort_order" type="number" min="0" max="65535" value="0" required/>
										</div>
									</div>
									<label for="line_server">对外地址</label>
									<input id="line_server" name="server" type="text" required maxlength="253" placeholder="例如 line.example.invalid"/>
									<label for="line_port">对外端口</label>
									<input id="line_port" name="port" type="number" min="1" max="65535" required placeholder="8443"/>
									<label for="line_server_name">server_name</label>
									<input id="line_server_name" name="server_name" type="text" required maxlength="253" placeholder="例如 handshake.example.invalid"/>
									<label for="line_handshake">握手伪装地址</label>
									<input id="line_handshake" name="handshake_server" type="text" required maxlength="253" placeholder="例如 handshake.example.invalid"/>
									<label for="line_handshake_port">握手伪装端口</label>
									<input id="line_handshake_port" name="handshake_port" type="number" min="1" max="65535" required placeholder="443"/>
									<p class="hint">改展示名不会让已有客户端配置失效；参数只保存在控制台，不会自动改到主机。<span class="info" title="保存已存在的 Line 时保留其 REALITY 密钥，改展示名或排序不影响客户端配置。">!</span></p>
									<button type="submit">保存线路参数 →</button>
								</form>
							</section>
					</div>
					<section class="panel">
						<div class="panel-heading"><h2>订阅用户</h2><span class="badge">{ len(v.Subscribers) } 个</span></div>
						if len(v.Subscribers) == 0 {
							<p class="muted">尚未创建订阅用户。</p>
						}
						for _,sub:=range v.Subscribers {
							<article class="node-card">
								<div class="panel-heading">
									<h3>{ sub.DisplayName }</h3>
									<span class={ sub.StateClass }>{ sub.StateLabel }</span>
								</div>
								<dl class="details">
									<dt>Subscriber ID</dt><dd><code data-copy>{ sub.ID }</code></dd>
									<dt>线路选择</dt><dd>{ sub.Total } 条</dd>
									<dt>生效状态</dt>
									<dd class="sub-summary">
										if sub.Total == 0 {
											<span class="muted">尚未选择线路</span>
										} else {
											<span class="sub-summary-count">{ sub.Confirmed }/{ sub.Total } 条线路已确认</span>
											<span class={ sub.SyncClass }>{ sub.SyncLabel }</span>
											if sub.SyncCode != "" {
												<code class="sub-code">{ sub.SyncCode }</code>
											}
										}
									</dd>
								</dl>
								for _,line:=range sub.Lines {
									<div class="sub-line">
										<span class="sub-line-name">{ line.DisplayName }<br/><span class="sub-line-endpoint">{ line.Server }:{ line.Port }</span></span>
										<span>
											<span class="sub-intent">{ line.Intent }</span><br/>
											if line.SyncStatus == store.SubscriberSyncHealthy {
												<span class="sub-confirmed is-confirmed">{ line.Confirmed }</span>
											} else if line.SyncStatus == store.SubscriberSyncPending {
												<span class="sub-confirmed is-pending">{ line.Confirmed } · <code class="sub-code">{ line.SyncCode }</code></span>
											} else if line.SyncStatus == store.SubscriberSyncPartial {
												<span class="sub-confirmed is-failed">{ line.Confirmed } · <code class="sub-code">{ line.SyncCode }</code></span>
											} else {
												<span class="sub-confirmed">{ line.Confirmed }</span>
											}
										</span>
									</div>
								}
								<form method="post" action="/subscribers/rename">
									<input type="hidden" name="csrf" value={ p.CSRF }/>
									<input type="hidden" name="subscriber_id" value={ sub.ID }/>
									<div class="sub-inline">
										<div>
											<label for={ "rename_" + sub.ID }>修改展示名</label>
											<input id={ "rename_" + sub.ID } name="display_name" type="text" required maxlength="80" value={ sub.DisplayName }/>
										</div>
										<button type="submit">保存名称</button>
									</div>
								</form>
								<form method="post" action="/subscribers/lines">
									<input type="hidden" name="csrf" value={ p.CSRF }/>
									<input type="hidden" name="subscriber_id" value={ sub.ID }/>
									<label>线路选择</label>
									if len(v.Lines) == 0 {
										<p class="hint">还没有已配置的线路。</p>
									} else {
										<div class="sub-check-list">
											for _,line:=range sub.Lines {
												<label class="sub-check">
													<input type="checkbox" name={ "line_" + line.NodeID } value="1" checked?={ line.Selected }/>
													<span class="sub-check-text">{ line.DisplayName }<small>{ line.Server }:{ line.Port }</small></span>
												</label>
											}
										</div>
									}
									<p class="hint">保留的线路沿用原有凭据，新增线路获得新凭据；移除的线路只是停用。<span class="info" title="移除的线路凭据保留可审计，UUID 不变。">!</span></p>
									<button type="submit">更新线路选择 →</button>
								</form>
								<div class="sub-actions">
									if sub.State == "active" {
										<form method="post" action="/subscribers/state"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><input type="hidden" name="action" value="pause"/><button class="secondary-button" type="submit">暂停</button></form>
									}
									if sub.State == "paused" {
										<form method="post" action="/subscribers/state"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><input type="hidden" name="action" value="resume"/><button class="secondary-button" type="submit">恢复</button></form>
									}
									if sub.State != "deleting" {
										<form method="post" action="/subscribers/state"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><input type="hidden" name="action" value="delete"/><button class="danger-button" type="submit">删除</button></form>
									}
									<form method="post" action="/subscribers/token/rotate"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><button class="secondary-button" type="submit">轮换 Token</button></form>
									<form method="post" action="/subscribers/token/revoke"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><button class="secondary-button" type="submit">吊销 Token</button></form>
									<form method="post" action="/subscribers/sync"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><input type="hidden" name="action" value="publish"/><button type="submit">同步到线路</button></form>
									<form method="post" action="/subscribers/sync"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="subscriber_id" value={ sub.ID }/><input type="hidden" name="action" value="retry"/><button class="secondary-button" type="submit">重试未确认线路</button></form>
								</div>
								<p class="sub-note">暂停、删除与吊销 Token 立即让订阅地址失效；已缓存的客户端配置稍后才真正停止。<span class="info" title="已缓存的客户端配置在线路本机确认后才真正停止授权。轮换 Token 只更换下载凭据，不改变 VLESS UUID。">!</span></p>
							</article>
						}
					</section>
					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>订阅用户 · 开发预览</span></footer>
				</main>
			</div>
		</div>
	}
}

// subscriptionDownloadURL builds one public subscription download address.
//
// The bearer is the last path segment, so the address is never logged by the
// Hub and never appears in a server log line.
func subscriptionDownloadURL(origin, token, format string) string {
	if origin == "" || token == "" {
		return "#"
	}
	return origin + "/subscription/" + token + "/" + format
}
