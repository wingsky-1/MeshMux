package web

import "time"

templ Document(title string) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · MeshMux</title>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"selfRequestsOnly":true,"historyCacheSize":0,"timeout":10000}'/>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/app.js" defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Brand() {
	<a class="brand" href="/" aria-label="MeshMux 概览"><span class="mark" aria-hidden="true">M</span><span>MeshMux<small>网络，由你掌控</small></span></a>
}

templ AuthPage(setup bool, csrf string, dev bool, message string, op string) {
	@Document("管理员认证") {
		<div class="auth-wrap">
			<section class="auth-story">
				@Brand()
				<div><p class="eyebrow">YOUR NETWORK. YOUR CONTROL.</p><h1>连接每一处。<br/><span>从这里开始。</span></h1><p class="lead">代理、私有组网与路由策略，<br/>一个清晰的管理入口。</p></div>
				<p class="muted">开发预览 · Web 安全基座<br/>代理与 Mesh 功能尚未实现</p>
			</section>
			<main class="auth-card">
				<div class="pill">本地管理员</div>
				if setup {
					<h2>初始化你的控制台</h2>
					<p class="muted">需要本机引导凭据。初始化完成后，此入口关闭。</p>
				} else {
					<h2>欢迎回来</h2>
					<p class="muted">登录 MeshMux，查看你的管理控制台。</p>
				}
				if dev {
					<div class="notice">本地开发模式 · HTTP 仅用于隔离环境</div>
				}
				if message != "" {
					<div class="error" role="alert">{ message }<small>AUTH_FAILED · { op }</small></div>
				}
				<form method="post" action={ templ.SafeURL(authAction(setup)) }>
					<input type="hidden" name="csrf" value={ csrf }/>
					<label for="account">管理员账号</label><input id="account" value="admin" autocomplete="username" readonly/>
					if setup {
						<label for="bootstrap">一次性引导凭据</label><input id="bootstrap" name="bootstrap" type="password" autocomplete="off" required maxlength="128"/>
						<p class="hint">从服务私有目录的 bootstrap.token 文件读取；有效期 30 分钟。不要分享此凭据。</p>
						<label for="password">设置管理员密码</label><input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256"/>
						<p class="hint">至少 12 个字符，最多 256 字节。建议使用密码管理器。</p>
						<button type="submit">初始化管理员 <span aria-hidden="true">→</span></button>
					} else {
						<label for="password">密码</label><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256" autofocus/>
						<button type="submit">登录控制台 <span aria-hidden="true">→</span></button>
					}
				</form>
				<p class="auth-foot">单管理员 · 安全会话 · 无第三方账户</p>
			</main>
		</div>
	}
}

templ Dashboard(p pageData) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> Web 基座 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">Web 安全基座</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					if p.Path=="/" {
						<p class="subtitle">欢迎回来。控制台已就绪，从这里查看后续纳管状态。</p>
						<section class="stats" aria-label="资源概览">
							<article><div class="stat-label">代理节点 <span>◇</span></div><strong>0</strong><p>尚未纳管 Line / Out</p></article>
							<article><div class="stat-label">订阅用户 <span>◎</span></div><strong>0</strong><p>尚未创建订阅</p></article>
							<article><div class="stat-label">Mesh 设备 <span>⌘</span></div><strong>0</strong><p>尚未连接私有网络</p></article>
							<article><div class="stat-label">待处理任务 <span>▤</span></div><strong>—</strong><p>任务执行器尚未实现</p></article>
						</section>
						<div class="overview-grid">
							<section class="panel network-panel"><div class="panel-heading"><h2>网络状态</h2><span class="badge">未部署</span></div><div class="empty-network"><span class="network-symbol" aria-hidden="true">◇</span><h3>你的网络，从第一个节点开始</h3><p>节点纳管将在后续阶段开放。<br/>当前没有连接任何代理或 Mesh 服务。</p><a href="/nodes">查看代理节点 <span aria-hidden="true">→</span></a></div></section>
							<section class="panel">
								<div class="panel-heading"><h2>控制台状态</h2><span class="badge accent">本机</span></div>
								@Status("当前请求")
								<p class="hint">只表示 Web 请求已处理，不代表代理握手、Mesh 或公网可用。</p><a class="refresh" href="/" hx-get="/status" hx-target="#web-status" hx-swap="outerHTML">刷新状态 ↻</a>
								<p id="status-feedback" class="hint" role="status"></p>
							</section>
						</div>
						<section class="panel next-panel"><div><span class="eyebrow">接下来</span><h2>建立连接之前，先把基础做好。</h2><p>本阶段开放管理员认证与安全设置；安装、代理、组网和订阅等待后续验收。</p></div><a class="secondary-link" href="/settings">安全设置 →</a></section>
					} else if p.Path=="/settings" {
						<p class="subtitle">管理本地管理员凭据与会话。</p>
						<div class="settings-grid">
							<section class="panel"><h2>修改管理员密码</h2><p class="muted">修改成功后撤销所有会话，请使用新密码重新登录。</p><form method="post" action="/password"><input type="hidden" name="csrf" value={ p.CSRF }/><label for="current">当前密码</label><input id="current" name="current_password" type="password" autocomplete="current-password" required maxlength="256"/><label for="new">新密码</label><input id="new" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="256"/><p class="hint">至少 12 个字符，最多 256 字节。</p><button type="submit">修改密码并退出登录</button></form></section>
							<section class="panel">
								<h2>认证边界</h2>
								<dl class="details">
									<dt>账号</dt>
									<dd>admin · 单管理员</dd>
									<dt>会话</dt>
									<dd>最长 8 小时 / 空闲 30 分钟</dd>
									<dt>并行登录</dt>
									<dd>新登录替换旧会话</dd>
									<dt>登录保护</dt>
									<dd>全局 10 次 / 10 分钟</dd>
									<dt>代理 IP 信任</dt>
									<dd>
										if p.DirectProxy {
											<span>仅本机直连 Caddy</span>
										} else {
											<span>关闭 · 不生成封禁候选</span>
										}
									</dd>
									<dt>Fail2ban</dt>
									<dd>候选配置 · 未验证主机状态</dd>
								</dl>
								<p class="hint">软件升级与 Web 备份功能尚未实现。</p>
							</section>
						</div>
					} else if p.Path=="/tasks" || p.Path=="/logs" {
						<p class="subtitle">操作结果需要可追踪，也需要真实的验证证据。</p>
						<div class="notice">以下是静态失败示例，不是真实任务或主机探测结果。</div>
						<section class="panel"><div class="panel-heading"><h2>SSH 监听端口预检 · 示例</h2><span class="badge failure">模拟失败</span></div><dl class="details"><dt>operation_id</dt><dd><code>demo-ssh-preflight</code></dd><dt>阶段</dt><dd>validate · 只读预检设计</dd><dt>error_code</dt><dd><code>SSH_LISTENER_MISMATCH</code></dd><dt>原因</dt><dd>示例中 SSH 实际监听端口与 jail 覆盖不一致。</dd><dt>建议动作</dt><dd>在后续安装阶段对照 sshd 有效配置、监听套接字与 Fail2ban action 的端口，分别核对 IPv4 / IPv6。</dd></dl><p class="hint">本阶段不读取系统 SSH 配置，不执行命令、不启用 jail、不修改防火墙。真实任务与日志查询尚未实现。</p></section>
					} else {
						<p class="subtitle">{ p.Title }将在后续开发阶段开放。</p>
						<section class="panel empty-page"><span class="network-symbol" aria-hidden="true">◇</span><h2>尚未实现</h2><p>当前仅提供 Web 安全基座。<br/>尚未纳管节点、生成订阅、连接 Headscale 或发布路由配置。</p><a href="/">返回概览 →</a></section>
					}
					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>开发预览，不用于生产环境</span></footer>
				</main>
			</div>
		</div>
	}
}

templ NodesPage(p pageData, nodes []Node, created *Node, pairingCode string, hubOrigin string) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> 节点配对 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">待纳管 · 一次性配对</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					<p class="subtitle">节点安装尚未开放。当前可创建待纳管记录和一次性配对码；实际安装由后续版本实现后开放。</p>
					if created != nil {
						<section class="panel"><div class="panel-heading"><h2>配对码已签发 · 仅显示一次</h2><span class="badge accent">15 分钟有效</span></div>
							<dl class="details"><dt>Node ID（不可变）</dt><dd><code>{ created.ID }</code></dd><dt>角色</dt><dd>{ created.Role }</dd><dt>一次性配对码</dt><dd><code>{ pairingCode }</code></dd></dl>
							<p class="hint">配对码仅显示一次，15 分钟内有效。当前仅供隔离协议验证，不要放入 shell argv、历史或 URL；安装指令尚未开放。</p>
						</section>
					}
					<div class="settings-grid">
						<section class="panel"><h2>创建待纳管节点</h2><form method="post" action="/nodes"><input type="hidden" name="csrf" value={ p.CSRF }/><label for="role">角色</label><select id="role" name="role" required><option value="edge">Line（edge）· 客户端入口</option><option value="out">Out · 可选私有出口</option></select><label for="display_name">展示名</label><input id="display_name" name="display_name" type="text" required maxlength="64" placeholder="例如 line-hk-01"/><label for="vless_port">VLESS 端口</label><input id="vless_port" name="vless_port" type="number" min="1" max="65535" required placeholder="例如 8443"/><label for="ssh_port">期望 SSH 端口</label><input id="ssh_port" name="ssh_port" type="number" min="1" max="65535" required placeholder="例如 2222"/><p class="hint">SSH 端口由你在目标主机上准备，安装器会在安装开放后检测它。VLESS 与 SSH 端口必须不同。配对码 15 分钟过期、一次性使用，不记日志。</p><button type="submit">创建并签发配对码 →</button></form></section>
						<section class="panel"><h2>纳管边界</h2><dl class="details"><dt>安装</dt><dd>尚未开放</dd><dt>Agent 协议</dt><dd>Agent 主动出站，仅执行固定范围内动作</dd><dt>Out 入站</dt><dd>安装后要求非授权 Line 默认拒绝（待实现）</dd><dt>离线行为</dt><dd>安装后 Agent 保持已验证配置（待实现）</dd></dl><p class="hint">所有操作可追踪；不支持远端任意 Shell / URL / 路径。</p></section>
					</div>
						<section class="panel"><div class="panel-heading"><h2>节点列表</h2><span class="badge">待纳管</span></div>
						if len(nodes) == 0 {
							<p class="muted">尚未创建待纳管节点。</p>
						} else {
							for _, n := range nodes {
								{{ heartbeatAt := "尚未收到" }}
								{{ if n.LastHeartbeat != 0 { heartbeatAt = time.Unix(n.LastHeartbeat, 0).Format("2006-01-02 15:04:05") } }}
								{{ lastSuccess := "尚无成功记录" }}
								{{ if n.LastSuccess != "" { lastSuccess = n.LastSuccess } }}
								<dl class="details"><dt>Node ID</dt><dd><code>{ n.ID }</code></dd><dt>角色 / 展示名</dt><dd>{ n.Role } · { n.DisplayName }</dd><dt>端口</dt><dd>VLESS { n.VlessPortString() } · SSH { n.SSHPortString() }</dd><dt>状态</dt><dd>{ n.Status } · agent { n.AgentVersion } · kernel { n.KernelVersion }</dd><dt>最近心跳</dt><dd>{ heartbeatAt }</dd><dt>最近成功</dt><dd>{ lastSuccess }</dd></dl>
							}
						}
						<p class="hint">“配对成功”只说明身份已建立。健康状态需要有效的最近心跳和最近成功记录。</p>
					</section>
					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>节点配对 · 开发预览</span></footer>
				</main>
			</div>
		</div>
	}
}

templ Status(checked string) {
	<div id="web-status" aria-live="polite"><dl class="status-list"><div><dt><span class="dot"></span> Web 服务</dt><dd>运行中</dd></div><div><dt>代理服务</dt><dd class="muted">尚未实现</dd></div><div><dt>Mesh 网络</dt><dd class="muted">尚未实现</dd></div><div><dt>公网与协议验证</dt><dd class="muted">未验证</dd></div></dl><p class="hint">更新于 { checked }</p></div>
}

templ ErrorPage(code string, message string, next string, op string) {
	@Document("请求未完成") {
		<main class="error-page">
			@Brand()
			<div class="panel"><span class="badge failure">请求未完成</span><h1>{ message }</h1><p>{ next }</p><dl class="details"><dt>错误码</dt><dd><code>{ code }</code></dd><dt>操作编号</dt><dd><code>{ op }</code></dd><dt>阶段</dt><dd>web</dd></dl><a href="/">返回控制台 →</a></div>
		</main>
	}
}
