package web

// MeshPage renders the mesh device workspace.
//
// The page is deliberately explicit about what it does and does not know:
//
//   - 待注册 means the Hub has a record and no observed Headscale node id;
//   - the online/address columns are a live Headscale read of this render and
//     are not persisted, while 最后观察 is the last persisted observation;
//   - the one-time enrollment key is shown once, in this response only.
//
// Nothing on this page proves public reachability, a Tailscale handshake or
// client availability; the footer says so instead of implying it.

templ MeshPage(p pageData, v meshPageView) {
	@Document(p.Title) {
		<a class="skip" href="#main">跳到内容</a>
		<div class="shell">
			<aside class="sidebar">
				@Brand()
				<div class="nav-label">工作空间</div>
				<nav aria-label="主导航">
					for _,item:=range navigation {
						if item.Path==p.Path {
							<a class="active" href={ templ.SafeURL(item.Path) } aria-current="page"><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						} else {
							<a href={ templ.SafeURL(item.Path) }><span aria-hidden="true">{ item.Icon }</span>{ item.Title }</a>
						}
					}
				</nav>
				<div class="sidebar-foot"><span class="dot"></span> Mesh 设备 · 开发预览<small>首个正式版本目标 v1.0.0</small></div>
			</aside>
			<div class="workspace">
				<header class="topbar"><span>控制台 <span class="crumb">/ { p.Title }</span></span><div class="account"><span class="avatar">A</span><span>管理员</span><form action="/logout" method="post"><input type="hidden" name="csrf" value={ p.CSRF }/><button class="text-button" type="submit">退出</button></form></div></header>
				<main id="main" class="content">
					<div class="page-heading"><div><p class="eyebrow">MESHMUX CONSOLE</p><h1>{ p.Title }</h1></div><span class="pill">Headscale · 一次性 Key</span></div>
					if p.Dev {
						<div class="notice">本地开发模式：仅用于隔离验收，未启用 HTTPS。</div>
					}
					<link rel="stylesheet" href="/assets/mesh.css"/>
					<p class="subtitle">Mesh 设备是独立的 Headscale 身份，与订阅 Token、VLESS 凭据互不影响；注册证据只来自观测到的 Headscale Node ID，未观测到之前一律显示“待注册”。</p>
					if v.Notice != "" {
						<div class={ meshNoticeClass(v.NoticeClass) } role="status">{ v.Notice }</div>
					}
					if v.Disclosure != nil {
						<section class="panel key-disclosure">
							<div class="panel-heading"><h2>一次性入网 Key 已签发 · 仅显示一次</h2><span class="badge accent">{ v.Disclosure.Device }</span></div>
							<p class="hint">此 Key 只在本次响应中出现，Hub 只保存它的 SHA-256 摘要。离开本页后无法再次查看；遗失请在设备列表中重新签发。请勿把它写入命令行、URL、Shell 历史或日志。</p>
							<pre class="sub-secret">{ v.Disclosure.Secret }</pre>
							<dl class="details">
								<dt>有效期至</dt><dd>{ v.Disclosure.Expires }</dd>
								<dt>绑定</dt><dd class="muted">Key 与这台设备记录绑定：一次性、不可复用，注册成功后立即作废。</dd>
							</dl>
							<p class="hint">客户端入网方式（Tailscale 客户端或 sing-box 配置生成）尚未实现；当前只完成 Hub 侧记录、Key 签发与取消。</p>
						</section>
					}
					<div class="mesh-split">
						<section class="panel">
							<h2>新增 Mesh 设备</h2>
							<p class="muted">创建后立即签发一次性 Key。用途决定是否绑定订阅用户；平台只影响后续客户端提示。</p>
							<form method="post" action="/mesh">
								<input type="hidden" name="csrf" value={ p.CSRF }/>
								<label for="mesh_name">设备名称</label>
								<input id="mesh_name" name="display_name" type="text" required maxlength="80" placeholder="例如 alice-iphone"/>
								<label for="mesh_purpose">用途</label>
								<select id="mesh_purpose" name="purpose" required>
									<option value="proxy_mesh">代理 + Mesh · 需绑定订阅用户</option>
									<option value="mesh_only">仅 Mesh · 使用现成 Tailscale 客户端</option>
									<option value="subnet_router">子网路由 · 可绑定订阅用户</option>
								</select>
								<label for="mesh_platform">客户端平台（仅影响提示文案）</label>
								<select id="mesh_platform" name="platform" required>
									<option value="ios">iOS</option>
									<option value="android">Android</option>
									<option value="linux">Linux</option>
									<option value="nas">NAS</option>
									<option value="other">其他</option>
								</select>
								<label for="mesh_user">Headscale 用户</label>
								if len(v.Users) == 0 {
									<input id="mesh_user" name="headscale_user" type="text" required maxlength="63" value={ v.DefaultUser }/>
									if v.UsersNotice != "" {
										<p class="hint">无法读取 Headscale 用户列表（<code>{ v.UsersNotice }</code>）。提交时会再次确认；只允许自动创建共享默认用户 { v.DefaultUser }。</p>
									} else {
										<p class="hint">Headscale 中还没有用户；提交时会创建共享默认用户 { v.DefaultUser }。</p>
									}
								} else {
									<select id="mesh_user" name="headscale_user" required>
										for _,user:=range v.Users {
											<option value={ user.Name } selected?={ user.Name == v.DefaultUser }>{ user.Name } · id { user.ID }</option>
										}
									</select>
									<p class="hint">只列出 Headscale 中已存在的用户；Hub 不会根据输入新建用户，仅在缺少共享默认用户 { v.DefaultUser } 时自动创建。</p>
								}
								<label for="mesh_subscriber">关联订阅用户（可选）</label>
								<select id="mesh_subscriber" name="subscriber_id">
									<option value="">不关联</option>
									for _,sub:=range v.Subscribers {
										<option value={ sub.ID }>{ sub.DisplayName } · { sub.State }</option>
									}
								</select>
								<p class="hint">代理 + Mesh 必须选择一个订阅用户；仅 Mesh 必须留空；子网路由可留空。删除一台设备不会停用整个订阅用户。</p>
								<button type="submit">创建并签发 Key →</button>
							</form>
						</section>
						<section class="panel">
							<h2>核对与边界</h2>
							<p class="muted">按钮会执行一次真实的 Headscale <code>nodes list</code>，并把观测结果写入设备记录；请求结束即完成，没有后台任务。</p>
							<form method="post" action="/mesh/reconcile">
								<input type="hidden" name="csrf" value={ p.CSRF }/>
								<button type="submit">重新核对全部设备</button>
							</form>
							<dl class="details">
								<dt>注册证据</dt><dd>只来自观测到的 Headscale Node ID；主机名与在线状态不算注册证据。</dd>
								<dt>在线列</dt><dd>本次页面渲染的 Headscale 快照，不持久化；读取失败显示“未核对”，不会显示成“离线”。</dd>
								<dt>最后观察</dt><dd>最近一次成功核对写入的时间。</dd>
								<dt>未实现</dt><dd class="muted">客户端配置/导入说明、子网路由批准（9b）、单 VPN Endpoint 渲染（9c）。</dd>
							</dl>
							if v.UsersNotice != "" {
								<p class="hint">Headscale 用户读取失败：<code>{ v.UsersNotice }</code></p>
							}
							if v.NodesNotice != "" {
								<p class="hint">Headscale 节点读取失败：<code>{ v.NodesNotice }</code></p>
							}
						</section>
					</div>
					<section class="panel">
						<div class="panel-heading"><h2>设备列表</h2><span class="badge">{ len(v.Devices) } 台</span></div>
						if len(v.Devices) == 0 {
							<div class="empty-network">
								<span class="network-symbol" aria-hidden="true">⌘</span>
								<h3>还没有 Mesh 设备</h3>
								<p>尚未创建 Mesh 设备，因此没有签发过入网 Key，也没有观测到 Headscale 节点。<br/>用左侧表单创建第一台设备；创建后这里会列出用途、绑定订阅用户、Node ID、Tailnet 地址、在线证据与 Key 状态。</p>
							</div>
						}
						for _,d:=range v.Devices {
							<article class="node-card">
								<div class="panel-heading">
									<h3>{ d.DisplayName }</h3>
									<span class={ d.StatusClass }>{ d.StatusLabel }</span>
								</div>
								<dl class="details">
									<dt>Device ID</dt><dd><code>{ d.ID }</code></dd>
									<dt>用途 / 平台</dt><dd>{ d.PurposeLabel } · { d.PlatformLabel }</dd>
									<dt>绑定订阅用户</dt>
									<dd>
										if d.SubscriberID == "" {
											<span class="muted">未绑定 · 独立于代理订阅</span>
										} else if d.SubscriberName != "" {
											<span>{ d.SubscriberName } · <code>{ d.SubscriberID }</code></span>
										} else {
											<span>已绑定 · <code>{ d.SubscriberID }</code></span>
										}
									</dd>
									<dt>Headscale 用户 / 节点名</dt><dd>{ d.HeadscaleUser } / <code>{ d.NodeName }</code></dd>
									<dt>Headscale Node ID</dt>
									<dd>
										if d.NodeID == "" {
											<span class="muted">尚未观测到 · 未注册</span>
										} else {
											<code>{ d.NodeID }</code>
										}
									</dd>
									<dt>Tailnet IP</dt><dd>{ d.TailnetIP }</dd>
									<dt>在线</dt><dd><span class={ d.OnlineClass }>{ d.Online }</span> <span class="muted">· 本次读取，不持久化</span></dd>
									<dt>最后观察</dt><dd>{ meshObservedLabel(d.ObservedAt) }</dd>
									<dt>入网 Key</dt>
									<dd>
										<span class={ d.KeyClass }>{ d.KeyLabel }</span>
										if d.KeyExpires != "" {
											<span class="muted"> · 有效期至 { d.KeyExpires }</span>
										}
									</dd>
									if d.RevokeReason != "" {
										<dt>注销原因码</dt><dd><code>{ d.RevokeReason }</code></dd>
									}
								</dl>
								<div class="sub-actions">
									if d.CanIssue {
										<form method="post" action="/mesh/rekey"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="device_id" value={ d.ID }/><button type="submit">重新签发 Key</button></form>
									}
									if d.CanRetry {
										<form method="post" action="/mesh/retry"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="device_id" value={ d.ID }/><button class="secondary-button" type="submit">重试注销</button></form>
									}
									if d.CanRevoke {
										<form method="post" action="/mesh/revoke"><input type="hidden" name="csrf" value={ p.CSRF }/><input type="hidden" name="device_id" value={ d.ID }/><button class="danger-button" type="submit">注销设备</button></form>
									}
								</div>
								<p class="sub-note">“注销”会移除这台设备的 Headscale 节点，远端确认后即为终态；不影响订阅用户、Token 轮换或其他设备。远端删除失败时设备保持“注销中”，可重试。未观测到 Node ID 的设备没有可删除的远端节点；如果它可能已经入网，请先“重新核对”，再删除观测到的节点。</p>
							</article>
						}
					</section>
					<p class="hint">本页只显示 Hub 侧记录与 Headscale 观测；“在线”不证明公网可达、真实协议握手或客户端可用。已签发 Key 的明文只在签发响应中出现，任何页面、URL 与日志都不会再次包含。</p>
					<footer class="page-footer"><span>MeshMux · 自托管网络控制台</span><span>Mesh 设备 · 开发预览</span></footer>
				</main>
			</div>
		</div>
	}
}

// meshNoticeClass maps one notice tone onto the existing alert classes.
func meshNoticeClass(class string) string {
	if class == "error" {
		return "error"
	}
	return "notice"
}

// meshObservedLabel renders the last persisted observation honestly: an empty
// value means the device was never reconciled, not that it is offline.
func meshObservedLabel(observed string) string {
	if observed == "" {
		return "尚未核对 · 从未观测"
	}
	return observed
}
